<?xml version="1.0" encoding="utf-8"?>
<!--
    NavigationActivity - Navegación en Bolsillo (Pocket Mode)
    MAPA como vista principal, Cámara secundaria (solo cuando se activa)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".ui.navigation.NavigationActivity">

    <!-- ============================================ -->
    <!-- CAPA 1: MAPA OSM (PRINCIPAL - VISIBLE) -->
    <!-- ============================================ -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ============================================ -->
    <!-- CAPA 2: CÁMARA (SECUNDARIA - OCULTA POR DEFECTO) -->
    <!-- ============================================ -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:scaleType="fillCenter" />

    <!-- ============================================ -->
    <!-- CAPA 3: OVERLAY DE DETECCIÓN -->
    <!-- ============================================ -->
    <com.blindnav.app.ui.overlay.BoundingBoxOverlay
        android:id="@+id/boundingBoxOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/directionCard"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:cardBackgroundColor="#CC000000"
        app:cardCornerRadius="100dp"
        app:cardElevation="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Flecha de dirección -->
            <TextView
                android:id="@+id/tvDirectionArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⬆️"
                android:textSize="64sp"
                android:rotation="0" />

            <!-- Hora de reloj -->
            <TextView
                android:id="@+id/tvClockDirection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 en punto"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Distancia -->
            <TextView
                android:id="@+id/tvDistanceToTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="150m"
                android:textColor="#4CAF50"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ============================================ -->
    <!-- CAPA 4: HUD SUPERIOR (INFORMACIÓN) -->
    <!-- ============================================ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hudCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#CC000000"
        app:cardCornerRadius="12dp"
        app:cardElevation="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Estado de navegación -->
            <TextView
                android:id="@+id/tvNavigationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🧭 NAVEGANDO..."
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:gravity="center" />

            <!-- Destino -->
            <TextView
                android:id="@+id/tvDestinationName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="→ Farmacia"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Próximo checkpoint -->
            <TextView
                android:id="@+id/tvNextCheckpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Próximo: Paso de cebra en 50m"
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:gravity="center" />
                
            <!-- Instrucción actual (texto gigante) -->
            <TextView
                android:id="@+id/tvCurrentInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="En 20m: Gira a la DERECHA"
                android:textColor="#FFEB3B"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ============================================ -->
    <!-- ALERTA DE PELIGRO -->
    <!-- ============================================ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hazardCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="#E6D32F2F"
        app:cardCornerRadius="12dp"
        app:cardElevation="20dp"
        app:layout_constraintTop_toBottomOf="@id/hudCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvHazardWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="⚠️ ¡OBSTÁCULO DETECTADO!"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

    </com.google.android.material.card.MaterialCardView>

    <!-- ============================================ -->
    <!-- PANEL DE GRABACIÓN (Solo en modo creador) -->
    <!-- ============================================ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/recordingPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="#EE212121"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/hudCard"
        app:layout_constraintBottom_toTopOf="@id/bottomControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:id="@+id/recordingActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Marca dónde empieza y acaba cada tramo"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFinishManeuver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:text="ACABA AQUÍ"
                    android:visibility="gone"
                    app:backgroundTint="#2E7D32" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelManeuver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="CANCELAR ESTE TRAMO"
                    android:visibility="gone" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCrossing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:text="PASO DE CEBRA: EMPIEZA AQUÍ"
                    app:backgroundTint="#1565C0" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStraight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:text="RECTO: EMPIEZA AQUÍ"
                    app:backgroundTint="#1565C0" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTurn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:text="GIRO A LA IZQUIERDA: EMPIEZA AQUÍ"
                    app:backgroundTint="#7B1FA2" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTurnRight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:text="GIRO A LA DERECHA: EMPIEZA AQUÍ"
                    app:backgroundTint="#7B1FA2" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnObstacle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="DICTAR OBSTÁCULO (OPCIONAL)" />
            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDescribeObstacle"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="10dp"
        android:text="¿QUÉ HAY DELANTE?"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="#1565C0"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ============================================ -->
    <!-- CONTROLES INFERIORES -->
    <!-- ============================================ -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botón Detener -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="⏹ DETENER"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:backgroundTint="#C62828"
            app:cornerRadius="16dp" />

        <!-- Switch Sonar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            app:cardBackgroundColor="#333333"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔊"
                    android:textSize="20sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSonar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:checked="true"
                    app:thumbTint="#4CAF50"
                    app:trackTint="#666666" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        
        <!-- Switch Cámara -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            app:cardBackgroundColor="#333333"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCameraIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👁️"
                    android:textSize="20sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchCamera"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:checked="false"
                    app:thumbTint="#4CAF50"
                    app:trackTint="#666666" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
    
    <!-- ============================================ -->
    <!-- FAB: ACTIVAR CÁMARA (ESCANEO TEMPORAL) -->
    <!-- ============================================ -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCamera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:contentDescription="Activar cámara para escaneo"
        app:srcCompat="@android:drawable/ic_menu_camera"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomControls"
        app:backgroundTint="#2196F3"
        app:tint="@android:color/white"
        app:fabSize="normal" />

</androidx.constraintlayout.widget.ConstraintLayout>
